{
  "name": "angular-declarative-way",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "lint": "eslint \"**/*.{ts,html}\" --no-error-on-unmatched-pattern",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier \"**/*.{ts,html,md,json,scss}\" --write",
    "prepare": "husky",
    "build": "echo \"Build script activates once the Angular app is scaffolded.\"",
    "test": "echo \"Test script activates once the Angular app is scaffolded.\""
  },
  "lint-staged": {
    "*.{ts,html}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,json,scss}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^19.8.0",
    "@angular-eslint/eslint-plugin-template": "^19.8.0",
    "@angular-eslint/template-parser": "^19.8.0",
    "@eslint/js": "^9.12.0",
    "angular-eslint": "^19.8.0",
    "eslint": "^9.12.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0"
  }
}
